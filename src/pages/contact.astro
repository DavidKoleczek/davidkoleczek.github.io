---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Contact - David Koleczek">
  <div class="px-4 py-8 max-w-3xl mx-auto">
    <Header />
    <p class="text-gray-700 dark:text-gray-300">
      The best place to reach me is on
      <a
        href="https://www.linkedin.com/in/david-koleczek/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-600 dark:text-blue-400 underline underline-offset-4"
      >
        LinkedIn</a
      >.
    </p>
  </div>
</BaseLayout>
