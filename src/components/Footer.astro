---
import ThemeToggle from "./ThemeToggle.astro";
---

<footer
  class="w-full border-t border-gray-200 dark:border-gray-800 py-1 mt-auto"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm text-gray-500 text-left my-1">
      This website should not be taken to reflect the views of any organization
      I'm affiliated with.
    </p>
    <div class="flex flex-row items-center justify-between gap-4">
      <ThemeToggle />

      <nav aria-label="Footer navigation">
        <a
          href="https://github.com/DavidKoleczek/davidkoleczek.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gray-600 dark:text-gray-400
                 hover:text-gray-900 dark:hover:text-gray-100
                 underline underline-offset-4 decoration-gray-300 dark:decoration-gray-700
                 hover:decoration-gray-500 dark:hover:decoration-gray-500
                 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2
                 dark:focus:ring-offset-gray-900
                 transition-colors"
        >
          Source on GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </nav>
    </div>
  </div>
</footer>
